# ---- Database (Neon PostgreSQL) ----
# Pooled connection string, used by the app at runtime
DATABASE_URL=
# Direct (non-pooled) connection string, used by `prisma migrate`
DIRECT_URL=

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Auth ----
# Long random string (min 16 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# OAuth 2.0 Web client ID from Google Cloud Console (same value as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# ---- CORS ----
# Allowed frontend origin(s), comma-separated. Leave empty to allow all (local dev only).
FRONTEND_URL=http://localhost:5173

# ---- Jobs ----
# Overdue-invoice job schedule (cron syntax, UTC). Default: hourly. Set to "off" to disable.
OVERDUE_CRON=0 * * * *
