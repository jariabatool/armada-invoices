# Neon pooled connection (used by the app at runtime)
DATABASE_URL=
# Neon direct connection (used by prisma migrate)
DIRECT_URL=
PORT=4000

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# OAuth 2.0 Web client ID from Google Cloud Console (same value as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Allowed CORS origin(s), comma-separated. Leave empty locally to allow all.
FRONTEND_URL=http://localhost:5173

# Overdue-invoice job schedule (cron syntax, UTC). Default: hourly. Set to "off" to disable.
OVERDUE_CRON=0 * * * *
